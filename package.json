{
  "name": "ai-code-tutor-ide",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "A standalone code editor where an animated AI tutor can move directly inside the code view.",
  "main": "electron/bootstrap.cjs",
  "scripts": {
    "dev": "concurrently -k -s first \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "reader:server": "node server/reader-room-server.mjs",
    "package:win": "electron-builder --win"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "monaco-editor": "0.56.0",
    "pg": "^8.16.3",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.0",
    "vite": "^8.0.16",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.chengyang.codetutor",
    "productName": "Code Tutor IDE",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "artifactName": "Code-Tutor-IDE-Setup-${version}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "Code-Tutor-IDE"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Code Tutor IDE",
      "uninstallDisplayName": "Code Tutor IDE"
    }
  }
}

{
  "name": "ai-code-tutor-ide",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "A standalone code editor where an animated AI tutor can move directly inside the code view.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -s first \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "monaco-editor": "0.56.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "electron": "43.2.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.16",
    "wait-on": "^8.0.0"
  }
}
